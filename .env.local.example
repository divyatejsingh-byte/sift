# Required: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional but recommended: GitHub personal access token (no scopes needed) to avoid the 60 req/hr anonymous rate limit
GITHUB_TOKEN=
# Optional: override the Gemini model (default gemini-3.8-flash)
GEMINI_MODEL=

# Optional: Supabase persistence for tracked repos + digest history (falls back to the browser if blank).
# Project Settings -> API. Keep the service-role key server-side only; never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
